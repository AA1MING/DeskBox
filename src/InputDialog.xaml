<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DeskBox.InputDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:deskbox="clr-namespace:DeskBox;assembly=DeskBox" Icon="/DeskBox;component/assets/app.ico" Title="DeskBox" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <StackPanel Name="DialogContent" Margin="22,18,22,18">
    <TextBlock Name="LabelText" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource TextFill}" />
    <TextBox Name="InputBox" Style="{StaticResource DeskTextBox}" FontSize="14" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Style="{StaticResource ToolButton}" Click="Cancel_Click" />
      <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>