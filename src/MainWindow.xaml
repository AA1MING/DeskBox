<?xml version="1.0" encoding="utf-8"?>
<Window xmlns:deskbox="clr-namespace:DeskBox;assembly=DeskBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:services="clr-namespace:DeskBox.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DeskBox.MainWindow" Icon="/DeskBox;component/assets/app.ico" Title="DeskBox" Width="980" Height="660" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Border Name="RootBorder" Opacity="0" CornerRadius="10" BorderThickness="1" Background="{DynamicResource PanelFill}" BorderBrush="{DynamicResource PanelStroke}" RenderTransformOrigin="0.5,0.5" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False">
    <UIElement.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        <TranslateTransform x:Name="RootSlide" X="0" Y="0" />
      </TransformGroup>
    </UIElement.RenderTransform>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Name="HeaderGrid" Row="0" Margin="20,16,20,12" SizeChanged="Header_SizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Name="BackButton" Grid.Column="0" Style="{StaticResource IconButton}" Content="" ToolTip="返回上一级" Visibility="Collapsed" VerticalAlignment="Center" Click="Back_Click" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Name="TitleText" Text="收纳盒" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFill}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="SubtitleText" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
        <Grid Name="HeaderSearch" Grid.Column="2" Margin="20,0" MaxWidth="440" Height="{Binding ActualHeight, ElementName=SettingsButton}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <TextBox Name="SearchBox" Style="{StaticResource DeskTextBox}" Padding="18,0,18,0" TextChanged="Search_TextChanged" ToolTip="搜索名称、拼音或首字母" />
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" />
          <TextBlock Name="SearchHint" Text="搜索" Margin="35,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                      <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Name="ClearSearchButton" Content="" Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" Margin="4" Visibility="Collapsed" ToolTip="清空搜索" Click="ClearSearch_Click" />
        </Grid>
        <StackPanel Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Name="PinButton" Style="{StaticResource IconButton}" Content="" Margin="0,0,8,0" Click="Pin_Click" />
          <Button Name="NewFolderButton" Content="新建文件夹" Style="{StaticResource ToolButton}" Click="NewFolder_Click" />
          <Button Name="SortButton" Content="一键排序" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="Sort_Click" />
          <Button Name="SettingsButton" Content="设置" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="Settings_Click" />
        </StackPanel>
      </Grid>
      <Grid Name="ItemsArea" Row="1" Background="#00FFFFFF" AllowDrop="True" DragOver="Area_DragOver" DragLeave="Area_DragLeave" Drop="Area_Drop" MouseRightButtonUp="Area_RightButtonUp">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="AreaSlide" X="0" Y="0" />
        </UIElement.RenderTransform>
        <ScrollViewer Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#00FFFFFF" Focusable="False" services:Motion.SmoothScroll="True">
          <ScrollViewer.Style>
            <Style TargetType="{x:Type ScrollViewer}">
              <Setter Property="Padding" Value="18,4,18,12" />
              <Style.Triggers>
                <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                  <!-- Balance the 14-DIP scrollbar gutter on the opposite side. -->
                  <Setter Property="Padding" Value="32,4,18,12" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <ItemsControl Name="ItemsHost" Background="#00FFFFFF">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" AllowDrop="True" Width="{Binding CellWidth}" Height="{Binding CellHeight}" Tag="{Binding}" MouseEnter="Item_MouseEnter" MouseLeftButtonDown="Item_MouseDown" MouseLeftButtonUp="Item_MouseUp" MouseMove="Item_MouseMove" MouseRightButtonUp="Item_RightButtonUp" DragOver="Item_DragOver" DragLeave="Item_DragLeave" Drop="Item_Drop" Name="ItemTile">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#00FFFFFF" />
                    </Style>
                  </FrameworkElement.Style>
                  <Grid>
                    <Border Name="ItemHover" CornerRadius="8" Background="{DynamicResource HoverFill}" Opacity="0" IsHitTestVisible="False" />
                    <Border Name="ItemDrop" CornerRadius="8" Background="{DynamicResource AccentSoftFill}" Opacity="0" IsHitTestVisible="False" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <Image Name="ItemIcon" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                          <TransformGroup>
                            <ScaleTransform x:Name="IconScale" />
                            <TranslateTransform x:Name="IconLift" />
                          </TransformGroup>
                        </Image.RenderTransform>
                      </Image>
                      <TextBlock TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="12" Margin="5,7,5,0" Foreground="{DynamicResource TextFill}" Text="{Binding Name}" Visibility="{Binding LabelVisibility}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="ItemTile" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ItemHover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static services:Motion.FeedbackDuration}">
                            <DoubleAnimation.EasingFunction>
                              <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                          <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.16" Duration="{x:Static services:Motion.FeedbackDuration}">
                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                          <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.16" Duration="{x:Static services:Motion.FeedbackDuration}">
                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                          <DoubleAnimation Storyboard.TargetName="IconLift" Storyboard.TargetProperty="Y" To="-3" Duration="{x:Static services:Motion.FeedbackDuration}">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ItemHover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static services:Motion.FeedbackDuration}">
                            <DoubleAnimation.EasingFunction>
                              <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                          <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{x:Static services:Motion.SettleDuration}">
                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                          <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{x:Static services:Motion.SettleDuration}">
                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                          <DoubleAnimation Storyboard.TargetName="IconLift" Storyboard.TargetProperty="Y" To="0" Duration="{x:Static services:Motion.SettleDuration}">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.ExitActions>
                  </Trigger>
                  <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <DataTrigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ItemDrop" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static services:Motion.FeedbackDuration}">
                            <DoubleAnimation.EasingFunction>
                              <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="ItemDrop" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static services:Motion.FeedbackDuration}">
                            <DoubleAnimation.EasingFunction>
                              <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.ExitActions>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
          <TextBlock Name="EmptyText" Text="拖入文件或快捷方式" FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFill}" />
          <TextBlock Name="EmptyDetail" Text="文件将移动到收纳目录" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
        <Border Name="DropOverlay" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Margin="10" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentFill}" Background="{DynamicResource AccentSoftFill}">
          <TextBlock Text="松开鼠标即可收纳" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFill}" />
        </Border>
      </Grid>
      <Grid Name="FooterPanel" Row="2" Margin="20,0,20,12" Visibility="Collapsed">
        <TextBlock Name="StatusText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
      </Grid>
    </Grid>
  </Border>
</Window>
