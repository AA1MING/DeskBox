<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DeskBox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:deskbox="clr-namespace:DeskBox;assembly=DeskBox" Title="DeskBox" Width="980" Height="660" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Border Name="RootBorder" CornerRadius="10" BorderThickness="1" Background="{DynamicResource PanelFill}" BorderBrush="{DynamicResource PanelStroke}" RenderTransformOrigin="0.5,0.5">
    <UIElement.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        <TranslateTransform x:Name="RootSlide" X="0" Y="0" />
      </TransformGroup>
    </UIElement.RenderTransform>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="20,16,20,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Name="BackButton" Grid.Column="0" Style="{StaticResource IconButton}" Content="" ToolTip="返回上一级" Visibility="Collapsed" VerticalAlignment="Center" Click="Back_Click" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Name="TitleText" Text="收纳盒" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFill}" VerticalAlignment="Center" />
          <TextBlock Name="SubtitleText" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="PinButton" Style="{StaticResource IconButton}" Content="" Margin="0,0,8,0" Click="Pin_Click" />
          <Button Name="NewFolderButton" Content="新建文件夹" Style="{StaticResource ToolButton}" Click="NewFolder_Click" />
          <Button Name="SortButton" Content="一键排序" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="Sort_Click" />
          <Button Name="SettingsButton" Content="设置" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Click="Settings_Click" />
        </StackPanel>
      </Grid>
      <Grid Name="ItemsArea" Row="1" Background="#00FFFFFF" AllowDrop="True" DragOver="Area_DragOver" DragLeave="Area_DragLeave" Drop="Area_Drop" MouseRightButtonUp="Area_RightButtonUp">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="AreaSlide" X="0" Y="0" />
        </UIElement.RenderTransform>
        <ScrollViewer Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,4,18,12" Background="#00FFFFFF" Focusable="False">
          <ItemsControl Name="ItemsHost" Background="#00FFFFFF">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" Background="#00FFFFFF" AllowDrop="True" Width="{Binding CellWidth}" Height="{Binding CellHeight}" Tag="{Binding}" MouseLeftButtonDown="Item_MouseDown" MouseLeftButtonUp="Item_MouseUp" MouseMove="Item_MouseMove" MouseRightButtonUp="Item_RightButtonUp" DragOver="Item_DragOver" DragLeave="Item_DragLeave" Drop="Item_Drop">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Style.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource HoverFill}" />
                        </Trigger>
                        <DataTrigger Value="True" Binding="{Binding IsDropTarget}">
                          <Setter Property="Background" Value="{DynamicResource AccentSoftFill}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="12" Margin="5,7,5,0" Foreground="{DynamicResource TextFill}" Text="{Binding Name}" Visibility="{Binding LabelVisibility}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
          <TextBlock Text="把桌面上的快捷方式或文件拖到这里" FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFill}" />
          <TextBlock Text="原文件会被移动到收纳目录，桌面立刻变干净" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
        <Border Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="10" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentFill}" Background="{DynamicResource AccentSoftFill}">
          <TextBlock Text="松开鼠标即可收纳" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFill}" />
        </Border>
      </Grid>
      <Grid Name="FooterPanel" Row="2" Margin="20,0,20,12" Visibility="Collapsed">
        <TextBlock Name="StatusText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
      </Grid>
    </Grid>
  </Border>
</Window>